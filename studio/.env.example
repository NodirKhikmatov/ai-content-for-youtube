# Copy to .env and fill in. Never commit .env.
# See ../blueprint.md Section 5.3 (LLM routing) and Section 6 (stack) for what each of these is for.

# --- LLMs ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- Research grounding (Deep Research, Fact Checker agents) ---
TAVILY_API_KEY=

# --- Embeddings (Originality & Angle agent) ---
VOYAGE_API_KEY=

# --- Voice ---
ELEVENLABS_API_KEY=
# "elevenlabs" (default, real, paid — note even ElevenLabs' free plan
# rejects library-voice calls made via the API) or "fake" (macOS `say` +
# ffmpeg, free, no network call — see tools/voice.py's FakeTTSBackend).
VOICE_BACKEND=elevenlabs

# --- Video generation ---
# Kling issues an access-key/secret-key pair, not a single API key —
# tools/video_gen.py signs a JWT from these per request.
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
# Higgsfield (aggregator for Kling/Sora/Veo/Seedance/...) issues a
# key_id/key_secret pair from cloud.higgsfield.ai — a different account
# from Kling's own, not interchangeable with the keys above.
HIGGSFIELD_KEY_ID=
HIGGSFIELD_KEY_SECRET=
# Model slug Higgsfield routes the request to — swap to try a different
# model on the platform without a code change.
HIGGSFIELD_MODEL=seedance-2.0
# "kling" (default, real, paid), "higgsfield" (real, paid/credits, needs
# the two keys above), or "fake" (local ffmpeg synthetic clips, free, no
# account needed — see tools/video_gen.py's FakeVideoBackend).
VIDEO_GEN_BACKEND=kling

# --- Forced transcription (Subtitle agent) ---
DEEPGRAM_API_KEY=
# "deepgram" (default, real, paid) or "fake" (fabricates word timestamps
# from the known script instead of transcribing, free, no Deepgram account
# needed — see tools/transcribe.py's fake_transcribe).
TRANSCRIBE_BACKEND=deepgram

# --- Video-understanding judge (Quality Review agent) ---
# "gemini" (default, real, paid) or "fake" (fixed high rubric scores, free,
# no Gemini account needed — see agents/quality_review.py's _fake_verdict).
QUALITY_REVIEW_BACKEND=gemini

# --- YouTube Data API v3 (create a project + OAuth client in Google Cloud Console) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Populated after the first OAuth consent flow (scripts/youtube_auth.py, added Day 7).
YOUTUBE_REFRESH_TOKEN=

# --- Telegram (optional): lets Quality Review's approve/reject decision
# happen from a phone instead of requiring you at the terminal. Get a
# token from @BotFather, then message your bot once and read your chat_id
# from https://api.telegram.org/bot<TOKEN>/getUpdates. Leave both blank to
# keep using the terminal prompt.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Database (local dev via docker-compose.yml by default) ---
DATABASE_URL=postgresql://studio:studio@localhost:5434/studio

# --- Object storage: Cloudflare R2 (create bucket + API token in the Cloudflare dashboard) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=turning-point-media

# --- ffmpeg (Video Assembly, Subtitle) ---
# Plain `brew install ffmpeg` has no libass, so caption burn-in
# (agents/subtitle.py's burn_subtitles) fails with "No such filter:
# 'subtitles'". Install `brew install ffmpeg-full` (keg-only — not on PATH
# by default) and point these at it. Leave unset to use whatever `ffmpeg`/
# `ffprobe` resolve to on PATH.
FFMPEG_BINARY=/opt/homebrew/opt/ffmpeg-full/bin/ffmpeg
FFPROBE_BINARY=/opt/homebrew/opt/ffmpeg-full/bin/ffprobe
